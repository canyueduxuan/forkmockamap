<launch>
  <node pkg="mockamap" type="mockamap_node" name="mockamap_node" output="screen">
  <param name="use_random_seed" type="bool" value="true"/>
  <param name="seed" type="int" value="555"/>
  <param name="update_freq" type="double" value="1.0"/>

  <!--  box edge length, unit meter-->
  <param name="resolution" type="double" value="0.1"/>

  <!-- map size unit meter-->
  <param name="x_length" type="int" value="40"/>
  <param name="y_length" type="int" value="40"/>
  <param name="z_length" type="int" value="5"/>

  <param name="type" type="int" value="5"/>
  <!-- tree point clouds file path-->
  <param name="tree_file" type="str" value="$(find mockamap)/pointcloud/tree.ply"/>
  <param name="tree_density" type="double" value="8.0"/>
  <param name="flat_ground"    type="bool" value="false"/>
  <!-- if flat_ground == flase-->
  <!-- generate perlin noise terrain-->
  <param name="amplitude"    type="double" value="0.5"/>
  <param name="frequency"    type="double" value="0.17"/>

    </node>
  <node pkg="rviz" type="rviz" name="rviz" args="-d $(find mockamap)/config/forest.rviz" output="screen"/>
</launch>
