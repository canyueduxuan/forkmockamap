<launch>
  <node pkg="mockamap" type="mockamap_node" name="mockamap_node" output="screen">
  <param name="use_random_seed" type="bool" value="true"/>
  <param name="seed" type="int" value="555"/>
  <param name="update_freq" type="double" value="1.0"/>

  <!--  box edge length, unit meter-->
  <param name="resolution" type="double" value="0.1"/>

  <!-- map size unit meter-->
  <param name="x_length" type="int" value="100"/>
  <param name="y_length" type="int" value="100"/>
  <param name="z_length" type="int" value="5"/>

  <param name="type" type="int" value="6"/>
  <!-- generate perlin noise terrain-->
  <param name="amplitude"    type="double" value="10.0"/>
  <param name="frequency"    type="double" value="0.03"/>
  <param name="octaves"    type="int" value="3"/>

    </node>
  <node pkg="rviz" type="rviz" name="rviz" args="-d $(find mockamap)/config/perlin2d.rviz" output="screen"/>
</launch>
